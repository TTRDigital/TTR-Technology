  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=495(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/contact/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=611(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/it-helpdesk/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=612(?:&|$)
