  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=613(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/mfa-as-a-service/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=617(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/mdm-as-a-service/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=618(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/vulnerability-assessment/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=619(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/firewall-security/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=620(?:&|$)
