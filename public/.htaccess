# TTR Technology: static Next.js export on SiteGround (Apache).
# Does what WordPress and the server did before: one address, https, the old
# URLs, security headers, caching, compression and a real 404 status.

Options -Indexes
DirectoryIndex index.html
# The trailing slash is added by a rewrite below (on https), not by Apache.
DirectorySlash Off
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---- One address: https://ttrtechnology.com (no www), the live site's canonical URLs ----
  # www, the SiteGround temporary address (*.sg-host.com) and any other host
  # pointed at this site go to the main domain, path kept.
  RewriteCond %{HTTP_HOST} !^ttrtechnology\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^(.*)$ https://ttrtechnology.com/$1 [R=301,L]
  # http -> https (SiteGround passes https through its proxy as X-Forwarded-Proto).
  # Also turn on "HTTPS Enforce" in Site Tools > Security > SSL Manager.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # ---- Old WordPress URLs (keep above the trailing-slash rule) ----

  # Redirects the live site already had (WordPress / Rank Math), now in one hop.
  RewriteRule ^24-7-helpdesk/?$ https://%{HTTP_HOST}/it-helpdesk/ [R=301,L,NC]
  RewriteRule ^cloud-backup/?$ https://%{HTTP_HOST}/cloud-backup-services/ [R=301,L,NC]
  RewriteRule ^disaster-recovery/?$ https://%{HTTP_HOST}/disaster-recovery-plan/ [R=301,L,NC]
  RewriteRule ^it-consulting/?$ https://%{HTTP_HOST}/it-consulting-services/ [R=301,L,NC]
  RewriteRule ^managed-it-services/cyber-security/?$ https://%{HTTP_HOST}/cyber-security-24x7/ [R=301,L,NC]
  RewriteRule ^managed-it-services/endpoint-security/?$ https://%{HTTP_HOST}/whitepaper/endpoint-security-checklist-decoded/ [R=301,L,NC]
  RewriteRule ^managed-it-services/network-security/?$ https://%{HTTP_HOST}/whitepaper/network-security-solutions/ [R=301,L,NC]
  RewriteRule ^whitepaper/(ddos-attack-prevention-strategies(-3)?|how-xdr-security-is-transforming)/?$ https://%{HTTP_HOST}/whitepaper/types-of-cybersecurity/ [R=301,L,NC]
  RewriteRule ^datasheet/?$ https://%{HTTP_HOST}/resources/datasheets/ [R=301,L,NC]
  RewriteRule ^whitepaper/?$ https://%{HTTP_HOST}/resources/whitepapers/ [R=301,L,NC]
  RewriteRule ^resources/(datasheets|whitepapers)/\d+/?$ https://%{HTTP_HOST}/resources/$1/ [R=301,L,NC]

  # WordPress list pages: the blog's page 2 / 3 keep their URLs; other archive and
  # search pages (all noindex on the live site) go to the blog.
  RewriteRule ^blog/page/(\d+)/?$ https://%{HTTP_HOST}/blog/$1/ [R=301,L,NC]
  RewriteRule ^page/\d+/?$ https://%{HTTP_HOST}/ [R=301,L,NC]
  RewriteRule ^(?:category|author|search)(?:/.*)?$ https://%{HTTP_HOST}/blog/ [R=301,L,NC]
  RewriteRule ^(?:19|20)\d{2}(?:/\d{2}(?:/\d{2})?)?(?:/page/\d+)?/?$ https://%{HTTP_HOST}/blog/ [R=301,L]
  RewriteCond %{QUERY_STRING} (?:^|&)s= [NC]
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/blog/ [R=301,L,QSD]
  # Page-builder fragments that were indexed by mistake.
  RewriteRule ^elementskit-content(?:/.*)?$ https://%{HTTP_HOST}/ [R=301,L,NC]
  RewriteCond %{QUERY_STRING} (?:^|&)elementskit_template= [NC]
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/ [R=301,L,QSD]

  # Old short links (?p= / ?page_id=): 301 to the page, query dropped.
  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=11(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=487(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/about-us/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=489(?:&|$)
