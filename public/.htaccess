  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=5981(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/whitepaper/network-infrastructure-security/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=5982(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/whitepaper/msp-for-protecting-client-data/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=5983(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/whitepaper/mitigate-m365-business-email-compromise-effectively/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=5984(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/whitepaper/mdr-vs-mssp-vs-siem/ [R=301,L,QSD]
  # Uploaded images and the video: the same file at its new address (any WordPress size,
  # e.g. -300x191, goes to the original). PDFs keep their exact old addresses and need no rule.
  RewriteCond %{DOCUMENT_ROOT}/images/$1 -f
  RewriteRule ^wp-content/uploads/(\d{4}/\d{2}/.+\.(?:jpe?g|png|gif|webp|svg))$ https://%{HTTP_HOST}/images/$1 [R=301,L,NC]
  RewriteCond %{DOCUMENT_ROOT}/images/$1$2 -f
  RewriteRule ^wp-content/uploads/(\d{4}/\d{2}/.+?)(?:-\d+x\d+)?(\.(?:jpe?g|png|gif|webp|svg))$ https://%{HTTP_HOST}/images/$1$2 [R=301,L,NC]
  RewriteCond %{DOCUMENT_ROOT}/images/$1-scaled$2 -f
  RewriteRule ^wp-content/uploads/(\d{4}/\d{2}/.+?)(?:-\d+x\d+)?(\.(?:jpe?g|png|gif|webp))$ https://%{HTTP_HOST}/images/$1-scaled$2 [R=301,L,NC]
  RewriteRule ^wp-content/uploads/\d{4}/\d{2}/(TTR-Technology-Managed-IT-Solutions\.mp4)$ https://%{HTTP_HOST}/video/$1 [R=301,L,NC]
  RewriteRule ^favicon\.ico$ https://%{HTTP_HOST}/brand/favicon-32x32.png [R=301,L]

  # WordPress sitemaps -> the one sitemap.
  RewriteRule ^(?:sitemap_index|wp-sitemap(?:-[a-z0-9_-]+)?|[a-z0-9_]+-sitemap\d*|main-sitemap)\.(?:xml|xsl)$ https://%{HTTP_HOST}/sitemap.xml [R=301,L,NC]
  RewriteRule ^index\.php$ https://%{HTTP_HOST}/ [R=301,L,NC]

  # WordPress-only addresses that no longer exist: 410 Gone, so search engines drop them.
  RewriteRule ^(?:wp-admin|wp-includes|wp-json|newsite|wp-content/(?:themes|plugins|cache|languages|upgrade|uploads/(?:elementor|siteground-optimizer-assets|essential-addons-elementor)))(?:/|$) - [G,L,NC]
  RewriteRule ^(?:wp-login|xmlrpc|wp-cron|wp-signup|wp-trackback|wp-comments-post|wp-activate|wp-mail|wp-links-opml)\.php$ - [G,L,NC]
  RewriteRule ^(?:.+/)?(?:feed|rss2?|atom|rdf|trackback|embed)/?$ - [G,L,NC]
  RewriteRule ^comments/feed/?$ - [G,L,NC]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:rest_route|feed|attachment_id|preview|replytocom)= [NC]
  RewriteRule ^(?:index\.php)?$ - [G,L]
  # ---- end of old WordPress URLs ----

  # Pages live at /page/ (page/index.html): add the missing slash, on https
  # (absolute, so visitors behind SiteGround's proxy are not bounced through http).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ https://%{HTTP_HOST}/$1/ [R=301,L]

  # The Sanity Studio is one page; its inner URLs (/cms/structure/...) load it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^cms/. /cms/index.html [L]
</IfModule>

# The upload tool's file list is never served.
<FilesMatch "^\.ftp-deploy-sync-state\.json$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

  # Content Security Policy. Third parties the pages really load: Google Tag Manager and
  # the Google tag (Site Kit) with Google Analytics; HoneyCRM (contact form) and Zoho CRM
  # (blog post form). If you add tags in GTM that load other scripts, add their domains here.
  # The studio at /cms talks to many Sanity hosts and is protected by Sanity login instead.
  <If "%{REQUEST_URI} !~ m#^/cms(/|$)#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.googletagmanager.com https://www.google-analytics.com https://cdn.honeycrm.com https://crm.zohopublic.com https://crm.zoho.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.google.com https://api.honeycrm.com https://*.honeycrm.com https://crm.zohopublic.com; frame-src 'self' https://www.googletagmanager.com; media-src 'self' https://cdn.sanity.io; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://crm.zoho.com; frame-ancestors 'self'; upgrade-insecure-requests"
  </If>

  # Caching: hashed build files forever, images, fonts, video and PDFs for a month, pages always fresh.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|woff2?|mp4|webm|pdf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType video/mp4 .mp4
  AddType application/pdf .pdf
</IfModule>

# Compress text files. Apache serves .js as text/javascript, so both JavaScript types are listed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml text/xml application/xml text/plain
</IfModule>
